{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and settings",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "preferredLanguage": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "journalEntries": {
      "title": "Journal Entries",
      "description": "User saved reflections and diary logs",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mood": { "type": "string" },
        "analysis": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "generatedTracks": {
      "title": "Generated Music Tracks",
      "description": "AI Lyria music tracks generated by users",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "audioUrl": { "type": "string" },
        "modelUsed": { "type": "string" },
        "createdAt": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "title", "audioUrl", "createdAt"]
    },
    "favoritePassages": {
      "title": "Favorite Sacred Passages",
      "description": "User bookmarked sacred verses",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "origin": { "type": "string" },
        "source": { "type": "string" },
        "text": { "type": "string" },
        "translation": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "source", "translation"]
    }
  }
